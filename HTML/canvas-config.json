{
  "name": "Guitar Luthier Canvas Web",
  "version": "1.0.0",
  "description": "Página web de guitarras personalizadas compatible con Canvas Apps",
  "type": "canvas-web-component",
  "main": "guitarras-canvas.html",
  "canvas": {
    "integration": {
      "type": "iframe",
      "communication": "postMessage",
      "responsive": true,
      "mobile-friendly": true
    },
    "capabilities": [
      "smooth-scrolling",
      "cta-tracking",
      "dynamic-content",
      "theme-switching",
      "mobile-responsive"
    ],
    "api": {
      "methods": [
        {
          "name": "getPageData",
          "description": "Obtiene datos actuales de la página",
          "returns": "object"
        },
        {
          "name": "performAction",
          "description": "Ejecuta una acción específica",
          "parameters": [
            {
              "name": "actionType",
              "type": "string",
              "required": true,
              "options": ["scroll-to-section", "show-notification", "trigger-cta"]
            },
            {
              "name": "data",
              "type": "object",
              "required": false
            }
          ]
        }
      ],
      "events": [
        {
          "name": "CANVAS_ACTION",
          "description": "Se dispara cuando el usuario interactúa con CTAs",
          "payload": {
            "action": "string",
            "timestamp": "string",
            "source": "string"
          }
        },
        {
          "name": "WEB_READY",
          "description": "Se dispara cuando la página está completamente cargada",
          "payload": {
            "timestamp": "string",
            "capabilities": "array"
          }
        }
      ]
    }
  },
  "assets": {
    "css": ["css/guitarras-canvas.css"],
    "js": ["js/guitarras-canvas.js"],
    "images": {
      "hero": "https://images.unsplash.com/photo-1510915361894-db8b60106cb1",
      "fallback": "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🎸%3C/text%3E%3C/svg%3E"
    }
  },
  "responsive": {
    "breakpoints": {
      "mobile": "480px",
      "tablet": "768px",
      "desktop": "1024px"
    },
    "design": "mobile-first"
  },
  "colors": {
    "primary": "#4ecdc4",
    "primary-hover": "#45b7b8",
    "background": "#1a1a2e",
    "secondary-bg": "#16213e",
    "text-primary": "#ffffff",
    "text-secondary": "#b8b8b8"
  },
  "fonts": {
    "primary": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
  }
}
